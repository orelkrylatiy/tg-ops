{
  "active_profile": "react",
  "out_dir": "vacancies",
  "resume_selection": {
    "auto_attach": true,
    "default_by_language": {
      "ru": "resume/resume-react.pdf",
      "en": "resume/resume-react-en.pdf"
    },
    "rules": [
      {
        "patterns": [
          "системн\\w+ аналитик",
          "system analyst",
          "systems analyst",
          "technical analyst"
        ],
        "file": "resume/resume-system-analyst.pdf"
      },
      {
        "patterns": [
          "react\\s*native",
          "react-native",
          "reactnative"
        ],
        "file": "resume/resume-react-native.pdf"
      },
      {
        "patterns": [
          "machine[ -]?learning",
          "\\bml\\b",
          "машинн\\w+ обуч"
        ],
        "file": "resume/resume-ml.pdf"
      },
      {
        "patterns": [
          "artificial intelligence",
          "\\bai\\b",
          "\\bllm\\b",
          "generative ai",
          "\\bии\\b",
          "искусственн\\w+ интеллект"
        ],
        "file": "resume/resume-ai.pdf"
      },
      {
        "patterns": [
          "full[ -]?stack",
          "фулл?стек"
        ],
        "file": "resume/resume-fullstack.pdf"
      },
      {
        "patterns": [
          "\\bvue\\b",
          "\\bnuxt\\b"
        ],
        "file": "resume/resume-vue.pdf"
      },
      {
        "patterns": [
          "\\bnode(?:\\.js|js)\\b"
        ],
        "file": "resume/resume-nodejs.pdf"
      }
    ]
  },
