{
  "channels": [
    {
      "id": "langiaflow",
      "enabled": false,
      "target": "@your_channel",
      "session": "userbot",
      "env_file": "/path/to/provider.env",
      "source_dir": "/path/to/content",
      "text_file": "ru.md",
      "image_pattern": "{slug}.png",
      "journal": "leads/channel-posts/langiaflow.jsonl",
      "timezone": "Europe/Moscow",
      "daily_limit": 1,
      "window_start": "09:00",
      "window_end": "21:05",
      "language": "ru",
      "domain": "general",
      "profile": "channel-editor",
      "description": "Редактор Telegram-канала",
      "prefer": ["ясный язык", "практическая польза"],
      "avoid": ["кликбейт", "неподтверждённые обещания"],
      "rules": ["Кратко объясни тему и пользу для читателя."],
      "max_chars": 900,
      "min_chars": 0
    }
  ]
}
