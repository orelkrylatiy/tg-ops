# Copy to /etc/tg-ops-admin.env and protect it (root:ubuntu, mode 0640).
# Fine-grained GitHub token with Contents: read access to orelkrylatiy/personal-wiki.
PERSONAL_WIKI_TOKEN=
PERSONAL_WIKI_BRANCH=main

# Private invite link from the LangiaFlow website, or a channel @username / -100... ID.
LANGIAFLOW_TELEGRAM_CHANNEL=https://t.me/+6AAsmbC3LK03YmZi

# Use a dedicated Telethon session ID configured in sessions.json.
LANGIAFLOW_TELEGRAM_SESSION=langiaflow
LANGIAFLOW_ALLOW_SHARED_SESSION=0

# Point this at the Humanizer Framework environment file if it is not in its repo root.
# HUMANIZER_ENV_FILE=/absolute/path/to/humanizer-framework/.env
